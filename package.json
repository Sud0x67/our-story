{
  "name": "our-story",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" \"*.html\" vite.config.js package.json .prettierrc.json \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\" \"*.html\" vite.config.js package.json .prettierrc.json \".github/workflows/*.yml\""
  },
  "dependencies": {
    "marked": "^16.4.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vite": "^7.1.12"
  }
}
